  "issues": [
    {
      "number": 6,
      "id": "I_kwDOU6xPE88AAAABVCNdeg",
      "title": "Private CLOCK_ID",
      "url": "https://github.com/afrind/draft-frindell-moq-timestamp/issues/6",
      "state": "OPEN",
      "author": "afrind",
      "authorAssociation": "OWNER",
      "assignees": [],
      "labels": [],
      "body": "The original version of the draft said CLOCK_ID=0 was referenced from the Unix Epoch, and an absent CLOCK_ID was track-private -- the timestamps were comparable within the track but not across any other tracks.  PR #4 removed this and CLOCK_ID defaults to Unix, and any present ID is a shared clock.  Publishers can choose unique values per track, but endpoints with track access can re-use that ID in their own Tracks.",
      "createdAt": "2026-10-05T04:45:05Z",
      "updatedAt": "2026-10-05T04:45:05Z",
      "closedAt": null,
      "comments": []
    },
    {
