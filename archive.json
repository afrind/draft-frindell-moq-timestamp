    {
      "number": 20,
      "id": "PR_kwDOU6xPE88AAAABL2l2mQ",
      "title": "Define CLOCK_ID 0 as a Track-private clock",
      "url": "https://github.com/afrind/draft-frindell-moq-timestamp/pull/20",
      "state": "OPEN",
      "author": "afrind",
      "authorAssociation": "OWNER",
      "assignees": [],
      "labels": [],
      "body": "Register CLOCK_ID 0 in the MOQ Clock IDs registry for a clock private to the Track, whose timestamps are comparable only within that Track, even with other Tracks that also carry 0.  This restores the private timeline #4 removed, without letting other Tracks reuse it.\n\nFixes #6",
      "createdAt": "2026-10-30T20:09:30Z",
      "updatedAt": "2026-11-01T02:06:59Z",
      "baseRepository": "afrind/draft-frindell-moq-timestamp",
